# --- Postgres (grey_two schema) ---
# Runtime credential: the grey_pipeline_rw scoped role (scoped to grey_two; cannot
# access autognostic.*). Used by grey-pipeline at runtime. NOT the migration credential.
GREY_DATABASE_URL=postgres://grey_pipeline_rw.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# --- LLM ---
ANTHROPIC_API_KEY=
GREY_MODEL=claude-sonnet-4-6

# --- Identity (ERC-8004 DID, minted in a later movement) ---
GREY_DID=

# --- Tier A wallet (hot, on VPS) — receiver-only, NEVER signs (split custody) ---
# BASE_X402_PAY_TO is the SAME address as the sweeper's GREY_AGENT_WALLET — one
# Tier-A hot wallet under two names: x402 payments are received here (payTo), and
# the sweeper moves accumulated USDC out of here to the Tier-B pool. The receiver
# holds NO key in grey-core; only @grey/sweeper signs (GREY_AGENT_WALLET_PRIVATE_KEY,
# invariant #17). (The stale BASE_X402_PRIVATE_KEY was removed — the receiver never signs.)
BASE_X402_PAY_TO=0x0000000000000000000000000000000000000000

# --- Tier B wallet (sweep destination, address only on VPS) ---
BASE_POOL_WALLET=0x0000000000000000000000000000000000000000

# --- Tier D central treasury (addresses only on VPS; keys held offline) ---
GREY_TREASURY_RECEIVE=0x0000000000000000000000000000000000000000
GREY_TREASURY_OPERATING=0x0000000000000000000000000000000000000000
GREY_TREASURY_TAX_RESERVE=0x0000000000000000000000000000000000000000

# --- Network / x402 (testnet defaults; flipped to mainnet in Step 8) ---
BASE_RPC_URL=
# Optional fallback RPC (Phase F): tried when the primary errors/rate-limits (viem fallback
# transport). Unset → the chain-matched public endpoint is used as backup automatically.
BASE_RPC_URL_FALLBACK=
BASE_SWEEP_THRESHOLD_USDC=200
BASE_SWEEP_GAS_RESERVE_USDC=20
X402_NETWORK=eip155:84532
X402_MAX_TIMEOUT_SECONDS=120
# X402_RELAYER_PRIVATE_KEY — gas-only relayer EOA (FDQ-31(a)) that broadcasts the
# buyer-signed EIP-3009 transferWithAuthorization for DIRECT settlement. Referenced ONLY by
# @grey/x402-middleware (invariant #19); grey-core never holds it. Forces generates it via the
# ceremony CLI + funds it with gas ETH at deploy. VPS-.env only — NO sample key committed here.
# X402_RELAYER_PRIVATE_KEY=

# --- Service runtime ---
GREY_CORE_PORT=3002
LOG_LEVEL=info

# --- Monitoring ---
ALERT_WEBHOOK_URL=

# === Deploy: systemd EnvironmentFile grouping (Movement 5 Phase D) ===
# The two units (infra/systemd/) each read ONE root-only 600 EnvironmentFile, authored by Forces
# ON THE VPS — never in the repo. This block records which keys belong to each file (the keys
# themselves are documented above). Testnet config this phase; mainnet flip is Phase E.
#
# /etc/grey/grey-core.env  (grey-core.service):
#   GREY_CORE_PORT=3002
#   GREY_DATABASE_URL=            # runtime rw cred (grey_pipeline_rw)
#   BASE_X402_PAY_TO=             # Tier-A receiver (0x)
#   X402_NETWORK=eip155:84532     # TESTNET this phase; mainnet (eip155:8453) is Phase E
#   BASE_RPC_URL=                 # Base Sepolia RPC (testnet)
#   X402_RELAYER_PRIVATE_KEY=     # gas-only relayer key — Forces-authored on-box (invariant #19)
#   GITHUB_TOKEN=                 # discovery source (optional)
#   CMC_API_KEY=                  # discovery source (optional)
#
# /etc/grey/sweeper.env  (grey-sweeper.service — installed DISABLED, enabled at Phase E):
#   GREY_SWEEPER_RPC_URL / GREY_SWEEPER_CHAIN_ID / GREY_AGENT_WALLET_PRIVATE_KEY /
#   GREY_USDC_ADDRESS / GREY_PG_URL / GREY_NTFY_OPS_URL / GREY_NTFY_CRIT_URL /
#   GREY_NTFY_USER / GREY_NTFY_PASS [/ GREY_SWEEPER_TICK_MS]
#
# === Phase F: relayer gas refuel (all OPTIONAL — code defaults are the ratified F-Q3(a) values) ===
# The sweeper refuels the x402 relayer from revenue each tick (USDC→ETH via Uniswap v3 DIRECT,
# delivered ONLY to the pinned relayer literal — invariant #21). Added to /etc/grey/sweeper.env
# only if overriding a default. The ETH DESTINATION is NOT env-configurable by design.
#   GREY_REFUEL_ENABLED=true                    # false = refuel fully inert (rollback lever)
#   GREY_REFUEL_FLOOR_WEI=500000000000000       # refuel when relayer ETH < 0.0005
#   GREY_REFUEL_TARGET_WEI=2000000000000000     # top back up to 0.002
#   GREY_REFUEL_HARDFLOOR_WEI=200000000000000   # below 0.0002 AND refuel failing → CRITICAL alert
#   GREY_REFUEL_MAX_USDC=10000000               # per-tick spend cap: $10 (6-decimal USDC-wei)
#   GREY_SWEEPER_RPC_URL_FALLBACK=              # optional backup RPC (unset → chain-matched public)
#
# GREY_SWEEPER_GAS_FLOOR_WEI — required ONLY by the on-demand `checkGas` script (grey-sweeper/
# src/checkGas.ts), NOT by the sweeper service itself (no default; unset makes checkGas throw).
# Deliberately no invented value here — set it once real Kite gas costs are better understood,
# not guessed now (E2 wrap-check, 2026-08-05).
# GREY_SWEEPER_GAS_FLOOR_WEI=

# === Mech adapter (BION-DIRECTIVE-45) — grey-mech-adapter.service, FULLY LIVE since 2026-08-13 ===
# Real, live-registered Olas mech (E3-B1, serviceId 635) — the ChannelIngress for the Mech
# Marketplace (Base). BION-DIRECTIVE-59: enabled, active, and MECH_ADAPTER_OBSERVE_ONLY=false in
# real production — Grey has made real, non-simulated deliveries through this channel. The default
# below (MECH_ADAPTER_OBSERVE_ONLY=true) is still the right template default for any NEW/local
# setup, same fail-safe posture every adapter in this repo defaults to — it does not reflect
# production's current real value, which lives only in /etc/grey/mech-adapter.env on the VPS.
#
# Tier A hot wallet — receives mech task payments (ceremony-generated, address only).
BASE_MECH_PAY_TO=0x0000000000000000000000000000000000000000
# Tier B pool wallet — consolidation point before eventual Tier D sweep (address only).
BASE_MECH_POOL_WALLET=0x0000000000000000000000000000000000000000
# MECH_ADAPTER_OBSERVE_ONLY — same FDQ-63-style safety gate every adapter in this repo uses.
# Defaults "true" (unset or any value other than the literal "false" stays observe-only).
MECH_ADAPTER_OBSERVE_ONLY=true
# Poll cadence (ms) for pollAndRespond — configurable, not hardcoded (mirrors grey-sweeper's own
# 5-minute tick as a reasonable default cadence for a real, not-yet-high-volume channel).
MECH_ADAPTER_POLL_INTERVAL_MS=300000
# BASE_MECH_AGENT_INSTANCE_PRIVATE_KEY — the sole (threshold=1) signer of Grey's real mech
# service's Safe multisig (0x5587335a...). Isolated hot key, invariant #30
# (adapters/mech-adapter/src/agentInstanceSigner.ts is the ONLY file in this repo allowed to read
# this env var). Ceremony-generated by Forces (EXPANSION-E3-B1-AGENT-INSTANCE-KEY-CEREMONY-
# RUNBOOK-FORCES.md) — VPS-.env only, NO sample key committed here.
# BASE_MECH_AGENT_INSTANCE_PRIVATE_KEY=
#
# Filebase credentials (BION-DIRECTIVE-45 Task 1) — dynamic, per-response IPFS pinning at request-
# serving time. A NEW, dedicated bucket (not `grey-olas`, which holds the static one-time-pinned
# registration metadata from D-38-ADDENDUM) — Forces' call which real bucket name/account to use;
# isolated the same way the private key above is
# (adapters/mech-adapter/src/filebaseCredentials.ts is the ONLY file allowed to read these three).
# Kov does not provision the real key — see BION-DIRECTIVE-45's own "out of scope". VPS-.env only.
# MECH_ADAPTER_FILEBASE_ACCESS_KEY_ID=
# MECH_ADAPTER_FILEBASE_SECRET_ACCESS_KEY=
# MECH_ADAPTER_FILEBASE_BUCKET=
#
# Optional — independent-of-gateway.autonolas.tech gateway. BION-DIRECTIVE-58: covers BOTH real
# gateway-dependent legs (unified deliberately, not two separate vars — see mechAdapter.ts's
# requestContentGatewayUrl doc comment) — verifying a freshly-pinned response actually resolves
# before delivering on it (responsePinner.ts), AND fetching what an incoming request's content
# actually asks for (taskIntake.ts/requestContent.ts). Defaults to gateway.autonolas.tech for both
# if unset. Production currently sets this to https://ipfs.io.
# MECH_ADAPTER_PIN_VERIFY_GATEWAY_URL=
#
# Also reused, already documented above: GREY_DATABASE_URL (shared handlers' cache reads),
# BASE_RPC_URL (defaults to Base's public RPC if unset).
#
# /etc/grey/mech-adapter.env (grey-mech-adapter.service — enabled, active, MECH_ADAPTER_OBSERVE_ONLY=false
# in real production since BION-DIRECTIVE-59, 2026-08-13):
#   BASE_MECH_PAY_TO / BASE_MECH_POOL_WALLET / GREY_DATABASE_URL / BASE_RPC_URL /
#   MECH_ADAPTER_OBSERVE_ONLY / MECH_ADAPTER_POLL_INTERVAL_MS /
#   BASE_MECH_AGENT_INSTANCE_PRIVATE_KEY / MECH_ADAPTER_FILEBASE_ACCESS_KEY_ID /
#   MECH_ADAPTER_FILEBASE_SECRET_ACCESS_KEY / MECH_ADAPTER_FILEBASE_BUCKET
#   [/ MECH_ADAPTER_PIN_VERIFY_GATEWAY_URL]
#
# --- Chain-scoping (BION-DIRECTIVE-101 §3) — Gnosis, entirely separate process/unit ---
# MECH_ADAPTER_CHAIN_ID — which chain this adapter PROCESS runs against. Defaults to 8453 (Base)
# when unset; every existing deployment (Base's) has no such var and is unaffected. Only 8453 or
# 100 are valid (config.ts's loadChainId() throws on anything else).
# MECH_ADAPTER_CHAIN_ID=8453
#
# MECH_ADAPTER_RPC_URL — generic override, checked before the legacy BASE_RPC_URL, before the
# chain's own default RPC. Optional on Base (BASE_RPC_URL still works as before); needed on Gnosis
# unless the public default (rpc.gnosischain.com) is acceptable.
# MECH_ADAPTER_RPC_URL=
#
# MECH_ADDRESS / MECH_MULTISIG_ADDRESS — the real, factory-created mech + its Safe multisig this
# process polls/delivers for. On Base (chainId 8453), OMITTING these defaults to the hardcoded,
# real, already-registered GREY_MECH_ADDRESS/GREY_MECH_MULTISIG_ADDRESS (config.ts) — every real
# deployment today omits them, unaffected. On any OTHER chain there is NO default: these don't
# exist until that chain's real ServiceRegistry lifecycle (create/activate/registerAgents/deploy,
# BION-DIRECTIVE-100/101) actually completes — loadMechIdentity() fails closed (throws at startup)
# without them, on purpose, rather than guess.
# MECH_ADDRESS=
# MECH_MULTISIG_ADDRESS=
#
# /etc/grey/mech-adapter-gnosis.env (infra/systemd/grey-mech-adapter-gnosis.service — NOT YET
# INSTALLED on the VPS as of this commit; MECH_ADDRESS/MECH_MULTISIG_ADDRESS don't have real values
# yet, see above). Once real: same shape as the Base file, plus the three new vars —
#   BASE_MECH_PAY_TO / BASE_MECH_POOL_WALLET / GREY_DATABASE_URL / MECH_ADAPTER_RPC_URL /
#   MECH_ADAPTER_CHAIN_ID=100 / MECH_ADAPTER_OBSERVE_ONLY (must start true) /
#   MECH_ADAPTER_POLL_INTERVAL_MS / BASE_MECH_AGENT_INSTANCE_PRIVATE_KEY (same key, same wallet,
#   reused across chains per D-77) / MECH_ADAPTER_FILEBASE_* (same credentials, reused) /
#   MECH_ADDRESS / MECH_MULTISIG_ADDRESS (real values, once D-100/101's registration lands)
#   [/ MECH_ADAPTER_PIN_VERIFY_GATEWAY_URL]
