# --- Postgres (grey_two schema) ---
# Runtime credential: the grey_pipeline_rw scoped role (scoped to grey_two; cannot
# access autognostic.*). Used by grey-pipeline at runtime. NOT the migration credential.
GREY_DATABASE_URL=postgres://grey_pipeline_rw.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# --- LLM ---
ANTHROPIC_API_KEY=
GREY_MODEL=claude-sonnet-4-6

# --- Identity (ERC-8004 DID, minted in a later movement) ---
GREY_DID=

# --- Tier A wallet (hot, on VPS) — receiver-only, NEVER signs (split custody) ---
# BASE_X402_PAY_TO is the SAME address as the sweeper's GREY_AGENT_WALLET — one
# Tier-A hot wallet under two names: x402 payments are received here (payTo), and
# the sweeper moves accumulated USDC out of here to the Tier-B pool. The receiver
# holds NO key in grey-core; only @grey/sweeper signs (GREY_AGENT_WALLET_PRIVATE_KEY,
# invariant #17). (The stale BASE_X402_PRIVATE_KEY was removed — the receiver never signs.)
BASE_X402_PAY_TO=0x0000000000000000000000000000000000000000

# --- Tier B wallet (sweep destination, address only on VPS) ---
BASE_POOL_WALLET=0x0000000000000000000000000000000000000000

# --- Tier D central treasury (addresses only on VPS; keys held offline) ---
GREY_TREASURY_RECEIVE=0x0000000000000000000000000000000000000000
GREY_TREASURY_OPERATING=0x0000000000000000000000000000000000000000
GREY_TREASURY_TAX_RESERVE=0x0000000000000000000000000000000000000000

# --- Network / x402 (testnet defaults; flipped to mainnet in Step 8) ---
BASE_RPC_URL=
BASE_SWEEP_THRESHOLD_USDC=200
BASE_SWEEP_GAS_RESERVE_USDC=20
X402_NETWORK=eip155:84532
X402_MAX_TIMEOUT_SECONDS=120
# X402_RELAYER_PRIVATE_KEY — gas-only relayer EOA (FDQ-31(a)) that broadcasts the
# buyer-signed EIP-3009 transferWithAuthorization for DIRECT settlement. Referenced ONLY by
# @grey/x402-middleware (invariant #19); grey-core never holds it. Forces generates it via the
# ceremony CLI + funds it with gas ETH at deploy. VPS-.env only — NO sample key committed here.
# X402_RELAYER_PRIVATE_KEY=

# --- Service runtime ---
GREY_CORE_PORT=3002
LOG_LEVEL=info

# --- Monitoring ---
ALERT_WEBHOOK_URL=

# === Deploy: systemd EnvironmentFile grouping (Movement 5 Phase D) ===
# The two units (infra/systemd/) each read ONE root-only 600 EnvironmentFile, authored by Forces
# ON THE VPS — never in the repo. This block records which keys belong to each file (the keys
# themselves are documented above). Testnet config this phase; mainnet flip is Phase E.
#
# /etc/grey/grey-core.env  (grey-core.service):
#   GREY_CORE_PORT=3002
#   GREY_DATABASE_URL=            # runtime rw cred (grey_pipeline_rw)
#   BASE_X402_PAY_TO=             # Tier-A receiver (0x)
#   X402_NETWORK=eip155:84532     # TESTNET this phase; mainnet (eip155:8453) is Phase E
#   BASE_RPC_URL=                 # Base Sepolia RPC (testnet)
#   X402_RELAYER_PRIVATE_KEY=     # gas-only relayer key — Forces-authored on-box (invariant #19)
#   GITHUB_TOKEN=                 # discovery source (optional)
#   CMC_API_KEY=                  # discovery source (optional)
#
# /etc/grey/sweeper.env  (grey-sweeper.service — installed DISABLED, enabled at Phase E):
#   GREY_SWEEPER_RPC_URL / GREY_SWEEPER_CHAIN_ID / GREY_AGENT_WALLET_PRIVATE_KEY /
#   GREY_USDC_ADDRESS / GREY_PG_URL / GREY_NTFY_OPS_URL / GREY_NTFY_CRIT_URL [/ GREY_SWEEPER_TICK_MS]
