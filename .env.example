# --- Postgres (grey_two schema) ---
# Runtime credential: the grey_pipeline_rw scoped role (scoped to grey_two; cannot
# access autognostic.*). Used by grey-pipeline at runtime. NOT the migration credential.
GREY_DATABASE_URL=postgres://grey_pipeline_rw.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# --- LLM ---
ANTHROPIC_API_KEY=
GREY_MODEL=claude-sonnet-4-6

# --- Identity (ERC-8004 DID, minted in a later movement) ---
GREY_DID=

# --- Tier A wallet (hot, on VPS) — placeholder, generated in Movement 4 ---
# BASE_X402_PAY_TO is the SAME address as the sweeper's GREY_AGENT_WALLET — one
# Tier-A hot wallet under two names: x402 payments are received here (payTo), and
# the sweeper moves accumulated USDC out of here to the Tier-B pool.
BASE_X402_PAY_TO=0x0000000000000000000000000000000000000000
BASE_X402_PRIVATE_KEY=

# --- Tier B wallet (sweep destination, address only on VPS) ---
BASE_POOL_WALLET=0x0000000000000000000000000000000000000000

# --- Tier D central treasury (addresses only on VPS; keys held offline) ---
GREY_TREASURY_RECEIVE=0x0000000000000000000000000000000000000000
GREY_TREASURY_OPERATING=0x0000000000000000000000000000000000000000
GREY_TREASURY_TAX_RESERVE=0x0000000000000000000000000000000000000000

# --- Network / x402 (testnet defaults; flipped to mainnet in Step 8) ---
BASE_RPC_URL=
BASE_SWEEP_THRESHOLD_USDC=200
BASE_SWEEP_GAS_RESERVE_USDC=20
X402_NETWORK=eip155:84532
X402_MAX_TIMEOUT_SECONDS=120

# --- Service runtime ---
GREY_CORE_PORT=3002
LOG_LEVEL=info

# --- Monitoring ---
ALERT_WEBHOOK_URL=
