{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Node CLI/runtime: uses process + Buffer. Base config sets types:[] so app packages stay
    // node-ambient-free unless they opt in (mirrors grey-ceremony/grey-sweeper).
    "types": ["node"]
  },
  "include": ["src"]
}
