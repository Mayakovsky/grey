{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
    // M5 Phase B (§3, D-RESOLVE closure): grey-core now consumes @grey/pipeline via its built .d.ts
    // (exports → dist; external in the bundle), NOT by source, so the pipeline's DOM-dependent
    // discovery files are no longer compiled under grey-core's options. The DOM lib leak is closed —
    // grey-core is DOM-free like the rest of the monorepo (base lib ["ES2022"]).
  },
  "include": ["src"]
}
