{
  "name": "@grey/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "tsx watch src/start.ts",
    "start": "tsx src/start.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dist-boot-smoke": "tsx scripts/dist-boot-smoke.ts",
    "parity-diff": "tsx scripts/parity-diff.ts",
    "margin-report": "tsx scripts/margin-report.ts"
  },
  "dependencies": {
    "@grey/pipeline": "workspace:*",
    "@grey/schemas": "workspace:*",
    "@grey/x402-middleware": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
