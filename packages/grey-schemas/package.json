{
  "name": "@grey/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./responses": { "types": "./dist/responses/index.d.ts", "default": "./dist/responses/index.js" },
    "./requests": { "types": "./dist/requests/index.d.ts", "default": "./dist/requests/index.js" },
    "./envelope": { "types": "./dist/envelope/index.d.ts", "default": "./dist/envelope/index.js" },
    "./validators": { "types": "./dist/validators/index.d.ts", "default": "./dist/validators/index.js" },
    "./openapi": "./openapi/openapi.yaml"
  },
  "files": ["dist", "openapi"],
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "codegen": "tsx scripts/codegen.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.22.4"
  }
}
